# Secrets & keys — never commit
.env
keys/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/

# Markdown — ignore all except root README.md
*.md
!README.md

# Databases — track the folder via .gitkeep, never the DB files
db_files/*.db

# Documentation folder — internal notes, not for version control
docs/

# Large data output folders
ohlcv_output/
ohlcv_cmc/
archive/

# Aider AI assistant files
.aider*

# Claude Code local config & memory — never commit
.claude/

# Downloaded / temp folders
downloaded_files/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/